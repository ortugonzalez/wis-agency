{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wis.agency/schemas/outreach-message.json",
  "title": "WIS Outreach Queue Message",
  "type": "object",
  "additionalProperties": false,
  "required": ["message_id", "idempotency_key", "prospect_key", "campaign_id", "batch_id", "source_sheet", "source_row", "empresa", "channel", "sequence", "recipient", "message_version", "approval_id", "eligibility", "status", "attempts", "next_action"],
  "properties": {
    "message_id": {"type": "string"},
    "idempotency_key": {"type": "string", "pattern": "^[^|]+\\|[^|]+\\|(EMAIL|WHATSAPP)\\|[1-3]$"},
    "prospect_key": {"type": "string"},
    "campaign_id": {"type": "string"},
    "batch_id": {"type": "string"},
    "source_sheet": {"type": "string"},
    "source_row": {"type": "integer", "minimum": 2},
    "empresa": {"type": "string"},
    "channel": {"enum": ["EMAIL", "WHATSAPP"]},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 3},
    "recipient": {"type": "string"},
    "message_version": {"type": "string"},
    "approval_id": {"type": "string"},
    "eligibility": {"enum": ["ELIGIBLE", "BLOCKED", "OPT_IN_REQUIRED", "TEMPLATE_REQUIRED"]},
    "status": {"enum": ["NUEVO", "RESEARCH_EN_CURSO", "RESEARCH_VALIDADO", "BORRADOR", "QA", "ESPERANDO_APROBACION", "APROBADO", "EN_COLA", "ENVIADO", "RESPONDIDO", "CERRADO", "BLOQUEADO", "REBOTADO", "OPTOUT", "OUTCOME_UNKNOWN", "DESCARTADO"]},
    "scheduled_at": {"type": ["string", "null"], "format": "date-time"},
    "sent_at": {"type": ["string", "null"], "format": "date-time"},
    "provider_ref": {"type": ["string", "null"]},
    "outcome": {"type": ["string", "null"]},
    "last_error": {"type": ["string", "null"]},
    "attempts": {"type": "integer", "minimum": 0},
    "next_action": {"type": "string"},
    "opt_in": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["verified", "source", "recorded_at", "within_24h"],
      "properties": {
        "verified": {"type": "boolean"},
        "source": {"type": "string"},
        "recorded_at": {"type": "string", "format": "date-time"},
        "within_24h": {"type": "boolean"},
        "approved_template": {"type": "boolean", "deprecated": true},
        "template_id": {"type": ["string", "null"], "deprecated": true}
      }
    }
  }
}
