# Non-secret configuration. Keep actual secrets in n8n credentials or a secret manager.
PORT=8600
X_USERNAME=ortu
X_SYSTEM_ENABLED=false
X_AUTO_PUBLISH_ONE_SHOT=false
X_DRY_RUN=true
X_MAX_WEIGHTED_CHARS=280
X_THREAD_MAX_POSTS=4
X_APPROVAL_TIMEOUT_MINUTES=120
TZ=America/Argentina/Buenos_Aires

# Inject these through a secret manager; never commit real values.
BOT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
